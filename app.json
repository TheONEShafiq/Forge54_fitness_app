{
  "expo": {
    "name": "Forge",
    "slug": "forge54",
    "version": "1.0.0",
    "scheme": "forge54",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sjadallah.forge54",
      "newArchEnabled": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ec7221"
      },
      "newArchEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d167183b-1d95-4219-ba06-e872b4ce47c2"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-router",
      "expo-audio",
      "expo-web-browser"
    ]
  }
}
